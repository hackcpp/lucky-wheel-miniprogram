<view class="page">
  <view class="tabs">
    <view class="tab {{cur==='eat'?'active':''}}" data-cat="eat" bindtap="switchCat">吃什么</view>
    <view class="tab {{cur==='play'?'active':''}}" data-cat="play" bindtap="switchCat">玩什么</view>
    <view class="tab {{cur==='custom'?'active':''}}" data-cat="custom" bindtap="switchCat">自定义</view>
  </view>

  <wheel id="wheel" items="{{items}}" bind:result="onResult" bind:spinstat="onSpinStat"></wheel>

  <view class="manage-entry {{spinning?'disabled':''}}" bindtap="goManage">管理选项</view>

  <view class="mask {{showResultCard?'':'hidden'}}" catchtap="closeResult">
    <view class="card" catchtap="noop">
      <view class="result">{{resultText}}</view>
      <view class="btns">
        <view class="btn btn-ghost" bindtap="closeResult">就它了</view>
        <view class="btn btn-primary" bindtap="spinAgain">再转一次</view>
      </view>
    </view>
  </view>
</view>
